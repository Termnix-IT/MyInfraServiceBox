# サーバ固有の設定。setup-server.sh が初回に /etc/myinfraservicebox/infra.env として作る。
# 実際の値を書いた infra.env は repo に含めない。
# 行末にコメントを書くと値の一部として読まれるので、コメントは行頭に書く。

# サーバの LAN 側 IP アドレス（ルーターの DHCP 予約などで固定しておく）
HOST_ADDR=192.0.2.10
# 宅内 LAN のアドレス帯。これ以外から公開ポートへの接続は捨てる
LAN_SUBNET=192.0.2.0/24
# LAN 側のネットワークインターフェース名（ip -br addr で確認できる）
LAN_IF=eth0

# 基盤のサービスが参加する共通 Docker ネットワークの名前とアドレス帯
INFRA_NETWORK=infra
INFRA_SUBNET=172.30.0.0/24

# ポータルの時刻表示に使うタイムゾーン
PORTAL_TIMEZONE=Asia/Tokyo
